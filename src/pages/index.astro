---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ArticleCard from '../components/ArticleCard.astro';

// Get current issue: newest issue with status: current
const allIssues = await getCollection('issues');
const currentIssues = allIssues
  .filter(i => i.data.status === 'current')
  .sort((a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0));
const currentIssue = currentIssues[0];

// Articles from current issue
const allArticles = [
  ...(await getCollection('essays', e => !e.data.draft)),
  ...(await getCollection('poetry', e => !e.data.draft)),
  ...(await getCollection('prose', e => !e.data.draft)),
  ...(await getCollection('interviews', e => !e.data.draft)),
  ...(await getCollection('conversation-with', e => !e.data.draft)),
  ...(await getCollection('criticism', e => !e.data.draft)),
];

const currentIssueSlug = currentIssue?.slug;
const currentIssueArticles = currentIssueSlug
  ? allArticles
      .filter(a => a.data.issue === currentIssueSlug)
      .sort((a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0))
      .slice(0, 6)
  : [];

// Latest from each section
const latestEssays = (await getCollection('essays', e => !e.data.draft))
  .sort((a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0))
  .slice(0, 2);
const latestPoetry = (await getCollection('poetry', e => !e.data.draft))
  .sort((a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0))
  .slice(0, 2);
const latestProse = (await getCollection('prose', e => !e.data.draft))
  .sort((a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0))
  .slice(0, 2);

function getHref(col: string, slug: string) {
  return `/${col}/${slug}/`;
}

const collectionMap: Record<string, string> = {
  essays: 'essays',
  poetry: 'poetry',
  prose: 'prose',
  interviews: 'interviews',
  'conversation-with': 'conversation-with',
  criticism: 'criticism',
};

function articleHref(a: { collection: string; slug: string }) {
  return `/${a.collection}/${a.slug}/`;
}
---

<Layout
  title="The Rang Yan Review — Literature, Philosophy, Solidarity"
  description="The Rang Yan Review is a literary and philosophical journal of critical thought, culture, and human solidarity."
>
  <Header />

  <main id="main-content">

    <!-- EPIGRAPH -->
    <section class="epigraph-section" aria-label="Journal epigraph">
      <div class="container">
        <blockquote class="epigraph">
          <p class="epigraph-line">
            “We inherit the most luminous layers —<br />
            and we spend our lives trying to accept the rest.”
          </p>
        </blockquote>
      </div>
    </section>

    <hr class="section-divider" />

    <!-- HERO: Current Issue -->
    {currentIssue && (
      <section class="hero-section" aria-labelledby="current-issue-heading">
        <div class="container">
          <div class="hero-inner">
            <div class="hero-content">
              <p class="category-label">Current Issue</p>
              <h1 id="current-issue-heading" class="hero-issue-number">
                Issue {currentIssue.data.number}
              </h1>
              <h2 class="hero-issue-title">{currentIssue.data.title}</h2>
              <p class="hero-issue-season">
                {currentIssue.data.season} {currentIssue.data.year}
              </p>
              <p class="hero-editorial">{currentIssue.data.editorial}</p>
              <a href="/archive/" class="btn-primary">Read current issue →</a>
            </div>
            <div class="hero-cover" aria-hidden="true">
              {currentIssue.data.coverImage ? (
                <img
                  src={currentIssue.data.coverImage}
                  alt={`Cover of Issue ${currentIssue.data.number}: ${currentIssue.data.title}`}
                  class="hero-cover-img"
                  width="560"
                  height="400"
                />
              ) : (
                <div class="hero-cover-placeholder">
                  <span>{currentIssue.data.number}</span>
                </div>
              )}
            </div>
          </div>
        </div>
      </section>
    )}

    <!-- FROM THE CURRENT ISSUE -->
    {currentIssueArticles.length > 0 && (
      <>
        <hr class="section-divider" />
        <section class="section" aria-labelledby="current-issue-articles-heading">
          <div class="container">
            <div class="section-header">
              <h2 id="current-issue-articles-heading" class="section-title">
                From the Current Issue
              </h2>
              <a href="/archive/" class="section-link">View full issue →</a>
            </div>
            <div class="articles-grid articles-grid--3">
              {currentIssueArticles.map(article => (
                <ArticleCard
                  category={article.data.category}
                  title={article.data.title}
                  author={article.data.author}
                  authorSlug={article.data.authorSlug}
                  date={article.data.date}
                  datePrecision={article.data.datePrecision}
                  excerpt={article.data.excerpt}
                  href={articleHref(article)}
                  tags={article.data.tags}
                />
              ))}
            </div>
          </div>
        </section>
      </>
    )}

    {(latestEssays.length > 0 || latestPoetry.length > 0 || latestProse.length > 0) && (
      <>
        <hr class="section-divider" />

        <!-- LATEST -->
        <section class="section" aria-labelledby="latest-heading">
          <div class="container">
            <h2 id="latest-heading" class="section-title">Latest</h2>
            <div class="latest-grid">
              <div class="latest-col">
                <div class="latest-col-header">
                  <h3 class="latest-col-title">
                    <a href="/essays/">Essays and Philosophy</a>
                  </h3>
                </div>
                {latestEssays.map(e => (
                  <ArticleCard
                    title={e.data.title}
                    author={e.data.author}
                    authorSlug={e.data.authorSlug}
                    date={e.data.date}
                    datePrecision={e.data.datePrecision}
                    excerpt={e.data.excerpt}
                    href={articleHref(e)}
                  />
                ))}
                <a href="/essays/" class="col-more-link">All essays and philosophy →</a>
              </div>

              <div class="latest-col">
                <div class="latest-col-header">
                  <h3 class="latest-col-title">
                    <a href="/poetry/">Poetry</a>
                  </h3>
                </div>
                {latestPoetry.map(p => (
                  <ArticleCard
                    title={p.data.title}
                    author={p.data.author}
                    authorSlug={p.data.authorSlug}
                    date={p.data.date}
                    datePrecision={p.data.datePrecision}
                    excerpt={p.data.excerpt}
                    href={articleHref(p)}
                  />
                ))}
                <a href="/poetry/" class="col-more-link">All poetry →</a>
              </div>

              <div class="latest-col">
                <div class="latest-col-header">
                  <h3 class="latest-col-title">
                    <a href="/prose/">Prose</a>
                  </h3>
                </div>
                {latestProse.map(p => (
                  <ArticleCard
                    title={p.data.title}
                    author={p.data.author}
                    authorSlug={p.data.authorSlug}
                    date={p.data.date}
                    datePrecision={p.data.datePrecision}
                    excerpt={p.data.excerpt}
                    href={articleHref(p)}
                  />
                ))}
                <a href="/prose/" class="col-more-link">All prose →</a>
              </div>
            </div>
          </div>
        </section>
      </>
    )}

    <hr class="section-divider" />

    <!-- ABOUT -->
    <section class="section about-section" aria-labelledby="about-heading">
      <div class="container">
        <div class="about-inner">
          <div class="about-content">
            <h2 id="about-heading" class="section-title">About the Journal</h2>
            <p>
              <em>The Rang Yan Review</em> is an independent literary and philosophical journal committed to critical thought, humanist culture, and the life of language. We publish essays, poetry, and prose that take seriously both aesthetic and political questions — that understand form and commitment to be not opposed but deeply entangled.
            </p>
            <p>
              We believe that literature and philosophy occupy an irreplaceable position in the public life of ideas: not the academy, not the market, but something between — a space for thinking that is too serious for entertainment and too committed for neutrality.
            </p>
            <a href="/about/" class="btn-secondary">More about the journal →</a>
          </div>
          <aside
            class="about-note about-note--collapsed"
            id="about-note"
            aria-label="Rang Yan Review: On the Name, and On Letting Be"
          >
            <div class="about-note__scroll">
              <div class="about-note__body">
                <h3 class="about-note__title"><em>Rang Yan Review</em>: On the Name, and On Letting Be</h3>
                <p>
                  The name <em>Rang Yan</em> comes from the Tibetan expression <em>rang yan</em> (རང་ཡན), which carries meanings such as “to let be, to abandon, to treat casually,” “naturally expansive, naturally unfolding, naturally dissipating,” and “free and relaxed.”
                </p>
                <p>
                  We were drawn to the phrase because it names a disposition toward things that is genuinely difficult to sustain. There is something generous in it, but also something exacting. To let something be is to allow it to remain, at least in part, outside our control — to relinquish, if only for a moment, the satisfaction of knowing precisely what a thing is, where it is heading, and what it is destined to become. This has consequences for how we think about language, culture, and the political.
                </p>
                <p>
                  The left has always had a complicated relationship with the desire for mastery. It has wanted to understand history, to organize collective existence, to give shared life a direction — and there is something to admire in that desire: the refusal to accept exploitation and humiliation as simply given facts of the world. Yet this same desire becomes dangerous the moment the future is imagined with too much clarity, the moment a political project begins to speak in the name of people who have not yet found occasion to speak for themselves.
                </p>
                <p>
                  The twentieth century makes this difficult to set aside. Again and again, emancipatory hope became entangled with apparatuses of discipline, with political languages that demanded certainty, with the conviction that a better society could be designed in advance and then simply installed. The state and capital, for their part, possess their own versions of this same certainty. What James Scott, in his account of high-modernist statecraft, called legibility — the reduction of a complex, illegible social reality to a set of standardized categories that can be counted, mapped, and administered — describes a form of power common to bureaucracies of every political colour: the world becomes governable to precisely the degree that it becomes legible.
                </p>
                <p>
                  We do not think the answer is withdrawal from collective life. We need solidarity, organization, institutions, material transformation. People need housing, healthcare, education, time, dignity, and the freedom to shape their own existence. The question is what kind of politics can pursue these things while still leaving room for what cannot yet be anticipated.
                </p>
                <p>
                  It is this space that interests us.
                </p>
                <p>
                  A materialist attentiveness begins by looking at what is already taking shape beneath the dominant order: forms of life that have not yet found a language, desires disciplined nearly out of existence, forms of solidarity that appear insignificant until someone learns how to perceive them at all. History is crowded with things that seemed impossible until, almost overnight, they became ordinary. Giorgio Agamben's notion of potentiality — the capacity of a life to remain not-yet-actualized, to retain the power not to pass into any single determinate form — offers one way of naming what such attentiveness watches for: not the actual as opposed to the possible, but the possible considered in its own right, before it has been foreclosed into one outcome among many.
                </p>
                <p>
                  This is where <em>rang yan</em> becomes useful to us. It suggests patience, but of a particular kind — not passive endurance, but a waiting that remains attentive, that allows something to unfold without presuming, in advance, to know its destination.
                </p>
                <p>
                  The distinction matters. Leaving existing relations untouched can simply mean accepting the world as given. <em>Rang yan</em> asks something considerably more demanding: how can we intervene in the conditions of life while resisting the temptation to determine every one of their possible outcomes in advance?
                </p>
                <p>
                  Nothing unfolds in a vacuum. Every life is shaped by material conditions — by bodies and institutions, by history, money, borders, language, memory, and power. Freedom has never existed outside these determinations. What matters is the possibility of altering the conditions themselves, so that lives might assume forms previously unavailable to them.
                </p>
                <p>
                  We also inherit a world before we are given any chance to choose it. We inherit languages we did not invent, histories we did not make, wounds we did not cause, and forms of beauty that were already waiting for us before we arrived. Some of what we inherit sustains us. Some of it wounds us. Often the two cannot be pulled apart.
                </p>
                <p class="about-note-epigraph">
                  We inherit the most luminous layers —<br />
                  and we spend our lives learning to accept the rest.
                </p>
                <p>
                  This is among the genuine difficulties of cultural inheritance. We cannot simply preserve everything, and we cannot simply discard everything. A living culture is produced through precisely this uncertain movement between attachment and critique, memory and transformation. Roberto Esposito's account of the <em>munus</em> at the root of every collective bond — a debt or obligation that precedes and exceeds any individual will — captures something of why inheritance cannot be a matter of pure selection: we do not simply choose what to keep, because what we inherit already, in some sense, has a claim on us before we have decided anything. Sometimes we keep something because it is beautiful. Sometimes we keep it because we have not yet found the words that would let us set it down. Sometimes we discover that what we believed belonged safely to the past is still, quietly, alive within us.
                </p>
                <p>
                  Perhaps letting be has something to do with this too: allowing an inheritance to remain complicated, rather than resolving it prematurely into either reverence or rejection.
                </p>
                <p>
                  Capitalism has very little patience for such complications. It wants to know what a thing can do, what it can produce, how quickly it can circulate, what it is worth. Jonathan Crary has described a contemporary order that no longer even tolerates the interruption of sleep, let alone the interruption of unproductive thought — a regime under which time is reorganized into schedules and attention is extracted as a resource, and under which waiting comes to be experienced as failure, slowness as a species of inefficiency. Byung-Chul Han, in a related register, has diagnosed a social order that pathologizes rest itself, treating any withdrawal from productivity, positivity, or self-optimization as symptomatic of a deficiency requiring correction.
                </p>
                <p>
                  There are moments when doing nothing is treated as something close to a moral defect.
                </p>
                <p>
                  We find this pressure everywhere: in work, in education, in cultural production, and increasingly in the very way people are asked to understand themselves. We are asked to optimize our bodies, our careers, our relationships, even our thoughts. The question “What are you doing with your life?” typically carries a second question folded beneath it: “What are you producing from it?”
                </p>
                <p>
                  There should be room for another answer.
                </p>
                <p>
                  There should be room for uselessness, hesitation, opacity, wandering, and unfinished thought.
                </p>
                <p>
                  The state has an appetite for legibility all its own. It wants names, categories, documents, identities, statistics. Institutions require information in order to function, but information can just as easily become a form of power in itself: a person becomes easier to manage precisely to the extent that they can be reduced to a category that already exists to receive them.
                </p>
                <p>
                  This is why we are interested in opacity — not as mere obscurity, but in something closer to what Édouard Glissant called the right to opacity: the claim that a person, a language, or a form of life need not render itself fully transparent, fully translatable into the terms of a dominant order, in order to be entitled to exist and to be recognized. A person should be allowed to contain more than the description assigned to them. A desire does not always need to congeal into an identity. A collectivity does not have to make itself completely transparent in order to deserve recognition. Fred Moten and Stefano Harney, writing on forms of collective life that refuse the terms on which they are asked to become legible to the institutions surrounding them, describe something structurally similar: a mode of being-together that survives precisely by declining full disclosure.
                </p>
                <p>
                  There is a form of freedom that lives in the parts of ourselves that remain untranslated.
                </p>
                <p>
                  This also changes how we think about literature.
                </p>
                <p>
                  We have no particular interest in turning literature into an instrument of correct opinion, of political instruction, or of persuasion. Literature can certainly enter political life. It can disturb a language, expose an unexamined assumption, preserve a memory, give shape to an experience that had previously seemed impossible to articulate. But its value does not depend on its capacity to deliver a message.
                </p>
                <p>
                  Sometimes a poem matters precisely because it refuses to tell us what to think.
                </p>
                <p>
                  Sometimes a novel gives us something we cannot immediately put to use.
                </p>
                <p>
                  Sometimes a sentence stays with us for years without ever hardening into an argument.
                </p>
                <p>
                  This is one reason we want <em>Rang Yan Review</em> to remain open to difficult, contradictory, unfinished writing — texts that take risks with language, that do not always explain themselves, whose meanings may shift depending on who reads them, and when. We want criticism, too, to retain something of this same uncertainty. A critic can illuminate a work without closing it down. Reading can be a form of companionship: one stays with something long enough for it to alter one's understanding of what one thought one already knew.
                </p>
                <p>
                  Perhaps this is where literature begins to complicate the very idea of ownership. A writer makes a work but cannot determine the whole of its subsequent life. Once a poem enters another person's memory, it has already travelled somewhere beyond its author. A translation changes it. A misreading changes it. Time changes it. A stranger may find in it something its author never intended and could not have foreseen.
                </p>
                <p>
                  Literature has always moved this way: across borders, languages, generations, classes, bodies. It is inherited, translated, borrowed, transformed, misread, given away.
                </p>
                <p>
                  Capital would prefer to convert all of this movement into property. Institutions may try to fix literature permanently to nations, traditions, identities, markets, or reputations. And yet something in literature keeps escaping these arrangements. A book printed by a corporation can still become someone's private refuge. A poem written in one century can suddenly become necessary to someone living in another. A language that once seemed marginal can become the very language in which a stranger finally recognizes themselves.
                </p>
                <p>
                  This is why we think literature matters politically: it produces forms of relation that cannot be entirely predicted or administered.
                </p>
                <p>
                  Perhaps this is also what we mean by solidarity. Jean-Luc Nancy's account of a community that remains, in his term, <em>inoperative</em> — never fully realized as a single unified substance, never completed into one collective identity — offers a way of naming the kind of togetherness we have in mind: we do not have to become identical in order to stand beside one another. We do not need to agree about everything before we can recognize another person's vulnerability, imagination, or right to exist. A collectivity can hold disagreement inside it. It can leave room for its members to remain, to some degree, strange to one another — closer, perhaps, to what Maurice Blanchot called an unavowable community than to any community organized around a shared confession of identity.
                </p>
                <p>
                  We are aware of the irony at work here. A journal devoted to “letting be” is itself an institution. We select texts. We edit them. We publish them under a name. We inevitably make choices about what enters this space and what remains outside it — and in this sense we too participate in exactly the operation of legibility we have just described.
                </p>
                <p>
                  We cannot escape that contradiction, and we have no wish to pretend otherwise.
                </p>
                <p>
                  Perhaps <em>Rang Yan</em> is valuable precisely because it gives us a way of remaining conscious of this contradiction rather than resolving it. We will inevitably shape the space we create. The real question is whether that shaping leaves room for surprise.
                </p>
                <p>
                  We want this journal to be such a space: shaped, but not sealed; political, but not doctrinaire; attentive to history without pretending that history has already disclosed what comes next.
                </p>
                <p>
                  Perhaps the left begins somewhere near here — with the willingness to listen before presuming to speak for others; with curiosity about forms of life that do not yet possess a recognized political vocabulary; with the possibility that the people who will eventually transform our understanding of freedom may not yet know that this is what they are doing.
                </p>
                <p>
                  We do not know in advance what freedom will look like.
                </p>
                <p>
                  That uncertainty can be frightening. It can also be a source of hope.
                </p>
                <p>
                  We are interested in what might emerge once there is enough space for something unanticipated to become possible.
                </p>
                <p>
                  And so we return, finally, to literature.
                </p>
                <p>
                  A poem cannot belong entirely to its author once it has entered the world. A language cannot remain permanently owned by those who first spoke it. A story can cross a border without asking anyone's permission. A sentence can outlive the person who wrote it and find a home in someone that person never knew and never could have known.
                </p>
                <p class="about-note-closing">
                  Literature does not belong to anyone.<br />
                  Literature belongs to everyone.
                </p>
                <p>
                  Perhaps that is the small paradox at the heart of <em>Rang Yan Review</em>: what cannot be possessed can still be shared. What remains singular can become collective. What begins as one person's voice can become part of another person's life.
                </p>
                <p>
                  We do not want to close this possibility with a final definition.
                </p>
                <p>
                  <em>Rang Yan</em> is not an answer.
                </p>
                <p>
                  It is a way of keeping the question open.
                </p>
              </div>
            </div>
            <div class="about-note__fade" aria-hidden="true"></div>
            <button
              type="button"
              class="about-note__toggle"
              id="about-note-toggle"
              aria-expanded="false"
              aria-controls="about-note"
            >
              Read more
            </button>
          </aside>
        </div>
      </div>
    </section>

    <section class="home-colophon" aria-label="The Rang Yan Review">
      <div class="container">
        <img
          src="/images/logo-rang-yan-review.png?v=3"
          alt="The Rang Yan Review — Solidarity Before Certainty"
          class="home-colophon__mark"
          width="640"
          height="640"
        />
      </div>
    </section>

  </main>

  <Footer />
</Layout>

<script>
  function syncAboutNotePreview() {
    const note = document.getElementById('about-note');
    const content = document.querySelector('.about-content');
    const toggle = document.getElementById('about-note-toggle');
    if (!(note instanceof HTMLElement) || !(content instanceof HTMLElement) || !(toggle instanceof HTMLButtonElement)) {
      return;
    }

    const syncHeight = () => {
      if (note.classList.contains('about-note--expanded')) {
        note.style.maxHeight = '';
        return;
      }
      if (window.matchMedia('(max-width: 1024px)').matches) {
        note.style.maxHeight = '22rem';
        return;
      }
      note.style.maxHeight = `${Math.max(content.offsetHeight, 16 * 16)}px`;
    };

    toggle.addEventListener('click', () => {
      const expanded = note.classList.toggle('about-note--expanded');
      note.classList.toggle('about-note--collapsed', !expanded);
      toggle.setAttribute('aria-expanded', expanded ? 'true' : 'false');
      toggle.textContent = expanded ? 'Show less' : 'Read more';
      syncHeight();
      if (!expanded) {
        note.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    });

    syncHeight();
    window.addEventListener('resize', syncHeight);
  }

  syncAboutNotePreview();
  document.addEventListener('astro:page-load', syncAboutNotePreview);
</script>

<style>
  /* Epigraph */
  .epigraph-section {
    position: relative;
    padding: 4.5rem 0 3.75rem;
    background:
      radial-gradient(ellipse 80% 70% at 50% 0%, rgba(124, 45, 62, 0.06), transparent 65%),
      linear-gradient(180deg, var(--color-paper-dark) 0%, var(--color-paper) 100%);
    border-bottom: 1px solid var(--color-border);
    overflow: hidden;
  }

  .epigraph-section::before,
  .epigraph-section::after {
    content: '';
    position: absolute;
    left: 50%;
    width: 3rem;
    height: 1px;
    background: var(--color-ink-muted);
    opacity: 0.45;
    transform: translateX(-50%);
  }

  .epigraph-section::before {
    top: 2rem;
  }

  .epigraph-section::after {
    bottom: 2rem;
  }

  .epigraph {
    margin: 0 auto;
    max-width: 40rem;
    text-align: center;
    border: none;
    padding: 0;
    animation: epigraph-rise 1.1s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .epigraph-line {
    font-family: var(--font-serif-body);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(1.35rem, 2.8vw, 1.75rem);
    line-height: 1.5;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    margin: 0;
  }

  @keyframes epigraph-rise {
    from {
      opacity: 0;
      transform: translateY(0.7rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .epigraph {
      animation: none;
    }
  }

  /* Hero Section */
  .hero-section {
    padding: 5rem 0 4rem;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: center;
  }

  .hero-issue-number {
    font-family: var(--font-serif);
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
    margin: 0.5rem 0 0;
  }

  .hero-issue-title {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0.5rem 0 0.5rem;
    color: var(--color-ink);
  }

  .hero-issue-season {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    color: var(--color-ink-muted);
    margin: 0 0 1.5rem;
    font-weight: 500;
  }

  .hero-editorial {
    font-family: var(--font-serif-body);
    font-size: 1rem;
    line-height: 1.75;
    color: var(--color-ink-secondary);
    margin-bottom: 2rem;
    display: -webkit-box;
    -webkit-line-clamp: 5;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .hero-cover {
