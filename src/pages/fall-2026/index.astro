---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const sectionOrder = [
  { key: 'poetry', title: 'Poetry' },
  { key: 'prose', title: 'Prose' },
  { key: 'criticism', title: 'Criticism' },
  { key: 'essays', title: 'Essays and Philosophy' },
  { key: 'interviews', title: 'Interviews' },
  { key: 'conversation-with', title: 'Conversation With' },
] as const;

const [poetry, prose, criticism, essays, interviews, conversations] = await Promise.all([
  getCollection('poetry', entry => !entry.data.draft),
  getCollection('prose', entry => !entry.data.draft),
  getCollection('criticism', entry => !entry.data.draft),
  getCollection('essays', entry => !entry.data.draft),
  getCollection('interviews', entry => !entry.data.draft),
  getCollection('conversation-with', entry => !entry.data.draft),
]);

const byGenre = {
  poetry,
  prose,
  criticism,
  essays,
  interviews,
  'conversation-with': conversations,
};

const contents = sectionOrder.map(section => ({
  title: section.title,
  items: [...byGenre[section.key]]
    .sort((a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0))
    .map(entry => ({
      author: entry.data.author,
      authorHref: `/authors/${entry.data.authorSlug}/`,
      title: entry.data.title,
      href: `/${section.key}/${entry.slug}/`,
    })),
}));

function titleHtml(title: string) {
  return title
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/\*([^*]+)\*/g, '<em>$1</em>');
}
---

<Layout
  title="Fall 2026 | The Rang Yan Review"
  description="Contents of the Fall 2026 issue of The Rang Yan Review."
>
  <Header />

  <main id="main-content">
    <div class="container issue-spread">
      <figure class="issue-spread__cover">
        <img
          src="/images/issue-01-cover.jpg"
          alt="Cover of The Rang Yan Review, Issue 01, Autumn 2026: a Paris street in autumn light, an open newspaper on a stone ledge"
          width="1024"
          height="1024"
          fetchpriority="high"
          decoding="async"
        />
      </figure>

      <div class="issue-spread__contents">
        <h1 class="issue-spread__heading">CONTENTS</h1>

        {contents.map(section => (
          <section class="issue-toc" aria-labelledby={`toc-${section.title.toLowerCase().replace(/\s+/g, '-')}`}>
            <h2 id={`toc-${section.title.toLowerCase().replace(/\s+/g, '-')}`} class="issue-toc__title">{section.title}</h2>
            <ul class="issue-toc__list">
              {section.items.map(item => (
                <li class="issue-toc__item">
                  <a class="issue-toc__author" href={item.authorHref}>{item.author}</a>
                  <a class="issue-toc__link" href={item.href} set:html={titleHtml(item.title)} />
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .issue-spread {
    display: grid;
    grid-template-columns: minmax(16rem, 0.86fr) minmax(0, 1.14fr);
    gap: 3rem 4rem;
    align-items: start;
    padding: 3.25rem 0 4.5rem;
  }

  .issue-spread__cover {
    margin: 0;
  }

  .issue-spread__cover img {
    display: block;
    width: 100%;
    height: auto;
    background: #c4b196;
    border: 1px solid rgba(26, 25, 22, 0.08);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.35) inset,
      0 22px 54px rgba(26, 25, 22, 0.16),
      0 3px 10px rgba(26, 25, 22, 0.07);
  }

  .issue-spread__heading {
    font-family: var(--font-serif);
    font-size: 0.84rem;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--color-burgundy);
    margin: 0 0 2rem;
    line-height: 1.2;
  }

  .issue-toc {
    margin: 0 0 2.15rem;
  }

  .issue-toc:last-child {
    margin-bottom: 0;
  }

  .issue-toc__title {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    color: var(--color-ink);
    margin: 0 0 0.85rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--color-ink);
  }

  .issue-toc__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .issue-toc__item {
    display: grid;
    grid-template-columns: minmax(8.5rem, 12rem) minmax(0, 1fr);
    gap: 0.75rem 1.25rem;
    align-items: baseline;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .issue-toc__author {
    font-family: var(--font-sans);
    font-size: 0.92rem;
    font-weight: 500;
    line-height: 1.4;
    color: var(--color-ink-secondary);
    text-decoration: none;
  }

  .issue-toc__author:hover {
    color: var(--color-burgundy);
  }

  .issue-toc__link {
    font-family: var(--font-serif);
    font-size: 1.08rem;
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: -0.012em;
    color: var(--color-ink);
    text-decoration: none;
  }

  .issue-toc__link:hover {
    color: var(--color-burgundy);
  }

  .issue-toc__link :global(em) {
    font-style: italic;
    font-weight: inherit;
  }

  @media (max-width: 900px) {
    .issue-spread {
      grid-template-columns: 1fr;
      gap: 2.25rem;
      padding: 2.25rem 0 3.25rem;
    }

    .issue-spread__cover {
      max-width: 34rem;
    }
  }

  @media (max-width: 640px) {
    .issue-toc__item {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }
  }
</style>
