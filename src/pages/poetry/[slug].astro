---
import { getCollection } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';

export async function getStaticPaths() {
  const poems = await getCollection('poetry', e => !e.data.draft);
  return poems.map(poem => ({
    params: { slug: poem.slug },
    props: { poem },
  }));
}

const { poem } = Astro.props;
const { Content } = await poem.render();

const authorBios = await getCollection('authors');
const alsoBy = (poem.data.translatorSlugs ?? []).map(slug => {
  const bio = authorBios.find(entry => entry.slug === slug);
  const rawName = bio?.data.name ?? slug;
  const comma = rawName.indexOf(',');
  const name = comma === -1
    ? rawName
    : `${rawName.slice(comma + 1).trim()} ${rawName.slice(0, comma).trim()}`;
  return { slug, name };
});
---

<ArticleLayout
  title={poem.data.title}
  author={poem.data.author}
  authorSlug={poem.data.authorSlug}
  date={poem.data.date}
  datePrecision={poem.data.datePrecision}
  excerpt={poem.data.excerpt}
  sourceNote={poem.data.sourceNote}
  tags={poem.data.tags}
  category={poem.data.category || 'Poetry'}
  issue={poem.data.issue}
  isPoetry={true}
  alsoBy={alsoBy}
>
  <Content />
</ArticleLayout>
