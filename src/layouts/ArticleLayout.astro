---
import Layout from './Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { plainInline, plainTitle, withJournalItalics, withTitleItalics } from '../lib/journal';

interface Props {
  title: string;
  author: string;
  authorSlug?: string;
  authorRole?: string;
  date?: Date;
  excerpt?: string;
  sourceNote?: string;
  tags?: string[];
  category?: string;
  issue?: string;
  coverImage?: string;
  coverCredit?: string;
  isPoetry?: boolean;
}

const {
  title,
  author,
  authorSlug,
  authorRole,
  date,
  excerpt,
  sourceNote,
  tags = [],
  category,
  issue,
  coverImage,
  coverCredit,
  isPoetry = false,
} = Astro.props;

const formattedDate = date
  ? date.toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : null;

const displayTitle = plainTitle(title);
const pageTitle = `${displayTitle} — ${author} | The Rang Yan Review`;
---

<Layout
  title={pageTitle}
  description={excerpt ? plainInline(excerpt) : undefined}
  ogTitle={displayTitle}
  ogDescription={excerpt ? plainInline(excerpt) : undefined}
  ogImage={coverImage ? `https://therangyanreview.org${coverImage}` : undefined}
  articleDate={date?.toISOString()}
>
  <Header />

  <main id="main-content">
    <article class="article-page">
      <header class="article-header container">
        <div class={`article-header__main${coverImage ? ' article-header__main--with-cover' : ''}`}>
          <div class="article-header__text">
            {category && <p class="category-label">{category}</p>}
            <h1 class="article-title" set:html={withTitleItalics(title)} />
            <div class="article-byline">
              {authorSlug ? (
                <a href={`/authors/${authorSlug}/`} class="article-byline__author">{author}</a>
              ) : (
                <span class="article-byline__author">{author}</span>
              )}
              {authorRole && (
                <>
                  <span aria-hidden="true">·</span>
                  <span class="article-byline__role">{authorRole}</span>
                </>
              )}
              {formattedDate && date && (
                <>
                  <span aria-hidden="true">·</span>
                  <time datetime={date.toISOString()}>{formattedDate}</time>
                </>
              )}
              {issue && (
                <>
                  <span aria-hidden="true">·</span>
                  <a href={`/archive/`} class="article-byline__issue">{issue}</a>
                </>
              )}
            </div>

            {excerpt && (
              <p
                class={`article-standfirst${excerpt.includes('*') ? ' article-standfirst--mixed' : ''}`}
                set:html={withJournalItalics(excerpt)}
              />
            )}

            {sourceNote && (
              <p
                class={`article-standfirst article-standfirst--follow${sourceNote.includes('*') ? ' article-standfirst--mixed' : ''}`}
                set:html={withJournalItalics(sourceNote)}
              />
            )}

            {tags.length > 0 && (
              <ul class="article-tags" role="list" aria-label="Tags">
                {tags.map(tag => (
                  <li class="article-tag">{tag}</li>
                ))}
              </ul>
            )}
          </div>

          {coverImage && (
            <figure class="article-cover">
              <img
                class="article-cover__img"
                src={coverImage}
                alt=""
                width="420"
                height="560"
                decoding="async"
              />
              {coverCredit && (
                <figcaption class="article-cover__credit">Photo by {coverCredit}</figcaption>
              )}
            </figure>
          )}
        </div>
      </header>

      <div class="article-body container">
        <div class={isPoetry ? 'prose-poetry' : 'prose-journal'}>
          <slot />
        </div>
      </div>

      <footer class="article-footer container">
        <div class="article-footer__inner">
          {authorSlug && (
            <a href={`/authors/${authorSlug}/`} class="article-footer__author-link">
              More by {author} →
            </a>
          )}
        </div>
      </footer>
    </article>
  </main>

  <Footer />
</Layout>

<style>
  .article-page {
    padding: 4rem 0 0;
  }

  .article-header {
    max-width: 72ch;
    margin-bottom: 3rem;
  }

  .article-header:has(.article-header__main--with-cover) {
    max-width: min(100%, 68rem);
  }

  .article-header__main--with-cover {
    display: flex;
    align-items: flex-start;
    gap: 1.75rem;
  }

  .article-header__text {
    flex: 1 1 auto;
    min-width: 0;
    max-width: 72ch;
  }

  .article-cover {
    flex: 0 0 auto;
    margin: 0;
  }

  .article-cover__img {
    display: block;
    width: 26.25rem;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: contain;
    object-position: center;
    background: #ffffff;
    border: 1px solid var(--color-border);
  }

  .article-cover__credit {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 400;
    letter-spacing: 0.02em;
    color: var(--color-ink-muted);
    margin-top: 0.55rem;
    line-height: 1.35;
  }

  @media (max-width: 900px) {
    .article-header__main--with-cover {
      flex-direction: column;
    }

    .article-cover__img {
      width: min(100%, 26.25rem);
    }
  }

  .article-header .category-label {
    margin-bottom: 1rem;
  }

  .article-title {
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 0 0 1.25rem;
    color: var(--color-ink);
  }

  .article-byline {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    color: var(--color-ink-muted);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .article-byline__author {
    color: var(--color-ink-secondary);
    font-weight: 600;
    text-decoration: none;
  }

  .article-byline__role {
    color: var(--color-ink-muted);
    font-weight: 500;
  }

  a.article-byline__author:hover,
  .article-byline__issue:hover {
    color: var(--color-burgundy);
  }

  .article-byline__issue {
    color: var(--color-ink-muted);
    text-decoration: none;
  }

  .article-standfirst {
    font-family: var(--font-serif-body);
    font-size: 1.2rem;
    line-height: 1.65;
    color: var(--color-ink-secondary);
    font-style: italic;
    border-top: 1px solid var(--color-border);
    padding-top: 1.25rem;
    margin-top: 0.5rem;
    margin-bottom: 0;
  }

  .article-standfirst--mixed {
    font-style: normal;
  }

  .article-standfirst--mixed em {
    font-style: italic;
  }

  .article-standfirst--follow {
    border-top: none;
    padding-top: 0.45rem;
    margin-top: 0;
  }

  .article-tags {
    list-style: none;
    padding: 0;
    margin: 1.25rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .article-tag {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    color: var(--color-ink-muted);
    background: var(--color-paper-dark);
    border: 1px solid var(--color-border);
    padding: 0.25rem 0.6rem;
    border-radius: 2px;
    letter-spacing: 0.02em;
  }

  .article-body {
    max-width: 72ch;
  }

  .article-footer {
    max-width: 72ch;
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
    margin-bottom: 0;
  }

  .article-footer__inner {
    display: flex;
    justify-content: flex-end;
  }

  .article-footer__author-link {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--color-burgundy);
    text-decoration: none;
  }

  .article-footer__author-link:hover {
    color: var(--color-burgundy-dark);
  }

  @media (max-width: 768px) {
    .article-page {
      padding: 2.5rem 0 0;
    }
  }
</style>
