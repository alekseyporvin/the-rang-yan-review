---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ArticleCard from '../components/ArticleCard.astro';

// Get current issue: newest issue with status: current
const allIssues = await getCollection('issues');
const currentIssues = allIssues
  .filter(i => i.data.status === 'current')
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const currentIssue = currentIssues[0];

// Articles from current issue
const allArticles = [
  ...(await getCollection('essays', e => !e.data.draft)),
  ...(await getCollection('poetry', e => !e.data.draft)),
  ...(await getCollection('prose', e => !e.data.draft)),
  ...(await getCollection('reading-room', e => !e.data.draft)),
];

const currentIssueSlug = currentIssue?.slug;
const currentIssueArticles = currentIssueSlug
  ? allArticles
      .filter(a => a.data.issue === currentIssueSlug)
      .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
      .slice(0, 6)
  : [];

// Reading room featured
const readingRoomItems = (await getCollection('reading-room', e => !e.data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 4);

// Latest from each section
const latestEssays = (await getCollection('essays', e => !e.data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 2);
const latestPoetry = (await getCollection('poetry', e => !e.data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 2);
const latestProse = (await getCollection('prose', e => !e.data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 2);

function getHref(col: string, slug: string) {
  return `/${col}/${slug}/`;
}

const collectionMap: Record<string, string> = {
  essays: 'essays',
  poetry: 'poetry',
  prose: 'prose',
  'reading-room': 'reading-room',
};

function articleHref(a: { collection: string; slug: string }) {
  return `/${a.collection}/${a.slug}/`;
}
---

<Layout
  title="The Rangzen Review — Literature, Philosophy, Solidarity"
  description="The Rangzen Review is a literary and philosophical journal of critical thought, culture, and human solidarity."
>
  <Header />

  <main id="main-content">

    <!-- HERO: Current Issue -->
    {currentIssue && (
      <section class="hero-section" aria-labelledby="current-issue-heading">
        <div class="container">
          <div class="hero-inner">
            <div class="hero-content">
              <p class="category-label">Current Issue</p>
              <h1 id="current-issue-heading" class="hero-issue-number">
                Issue {currentIssue.data.number}
              </h1>
              <h2 class="hero-issue-title">{currentIssue.data.title}</h2>
              <p class="hero-issue-season">
                {currentIssue.data.season} {currentIssue.data.year}
              </p>
              <p class="hero-editorial">{currentIssue.data.editorial}</p>
              <a href="/archive/" class="btn-primary">Read current issue →</a>
            </div>
            <div class="hero-cover" aria-hidden="true">
              {currentIssue.data.coverImage ? (
                <img
                  src={currentIssue.data.coverImage}
                  alt={`Cover of Issue ${currentIssue.data.number}: ${currentIssue.data.title}`}
                  class="hero-cover-img"
                  width="560"
                  height="400"
                />
              ) : (
                <div class="hero-cover-placeholder">
                  <span>{currentIssue.data.number}</span>
                </div>
              )}
            </div>
          </div>
        </div>
      </section>
    )}

    <hr class="section-divider" />

    <!-- FROM THE CURRENT ISSUE -->
    {currentIssueArticles.length > 0 && (
      <section class="section" aria-labelledby="current-issue-articles-heading">
        <div class="container">
          <div class="section-header">
            <h2 id="current-issue-articles-heading" class="section-title">
              From the Current Issue
            </h2>
            <a href="/archive/" class="section-link">View full issue →</a>
          </div>
          <div class="articles-grid articles-grid--3">
            {currentIssueArticles.map(article => (
              <ArticleCard
                category={article.data.category}
                title={article.data.title}
                author={article.data.author}
                authorSlug={article.data.authorSlug}
                date={article.data.date}
                excerpt={article.data.excerpt}
                href={articleHref(article)}
                tags={article.data.tags}
              />
            ))}
          </div>
        </div>
      </section>
    )}

    <hr class="section-divider" />

    <!-- READING ROOM -->
    <section class="section reading-room-section" aria-labelledby="reading-room-heading">
      <div class="container">
        <div class="section-header">
          <h2 id="reading-room-heading" class="section-title">Reading Room</h2>
          <a href="/reading-room/" class="section-link">All texts →</a>
        </div>
        <p class="section-intro">
          Essays, criticism, notes, and recommended reading — a space for engaged, unsystematic thinking.
        </p>
        <div class="reading-room-list">
          {readingRoomItems.map(item => (
            <ArticleCard
              category={item.data.category}
              title={item.data.title}
              author={item.data.author}
              authorSlug={item.data.authorSlug}
              date={item.data.date}
              excerpt={item.data.excerpt}
              href={articleHref(item)}
              tags={item.data.tags}
              size="large"
            />
          ))}
        </div>
      </div>
    </section>

    <hr class="section-divider" />

    <!-- LATEST -->
    <section class="section" aria-labelledby="latest-heading">
      <div class="container">
        <h2 id="latest-heading" class="section-title">Latest</h2>
        <div class="latest-grid">
          <div class="latest-col">
            <div class="latest-col-header">
              <h3 class="latest-col-title">
                <a href="/essays/">Essays</a>
              </h3>
            </div>
            {latestEssays.map(e => (
              <ArticleCard
                title={e.data.title}
                author={e.data.author}
                authorSlug={e.data.authorSlug}
                date={e.data.date}
                excerpt={e.data.excerpt}
                href={articleHref(e)}
              />
            ))}
            <a href="/essays/" class="col-more-link">All essays →</a>
          </div>

          <div class="latest-col">
            <div class="latest-col-header">
              <h3 class="latest-col-title">
                <a href="/poetry/">Poetry</a>
              </h3>
            </div>
            {latestPoetry.map(p => (
              <ArticleCard
                title={p.data.title}
                author={p.data.author}
                authorSlug={p.data.authorSlug}
                date={p.data.date}
                excerpt={p.data.excerpt}
                href={articleHref(p)}
              />
            ))}
            <a href="/poetry/" class="col-more-link">All poetry →</a>
          </div>

          <div class="latest-col">
            <div class="latest-col-header">
              <h3 class="latest-col-title">
                <a href="/prose/">Prose</a>
              </h3>
            </div>
            {latestProse.map(p => (
              <ArticleCard
                title={p.data.title}
                author={p.data.author}
                authorSlug={p.data.authorSlug}
                date={p.data.date}
                excerpt={p.data.excerpt}
                href={articleHref(p)}
              />
            ))}
            <a href="/prose/" class="col-more-link">All prose →</a>
          </div>
        </div>
      </div>
    </section>

    <hr class="section-divider" />

    <!-- ABOUT -->
    <section class="section about-section" aria-labelledby="about-heading">
      <div class="container">
        <div class="about-inner">
          <div class="about-content">
            <h2 id="about-heading" class="section-title">About the Journal</h2>
            <p>
              <em>The Rangzen Review</em> is an independent literary and philosophical journal dedicated to critical thought, humanist culture, and the life of language. We publish essays, poetry, and fiction that take seriously both the aesthetic and the political — that believe form and commitment need not be opposed.
            </p>
            <p>
              We are committed to maintaining a space that is rigorous without being academic, engaged without being sectarian, and attentive to the lives of people who do not always find themselves in the pages of literary journals.
            </p>
            <a href="/about/" class="btn-secondary">More about the journal →</a>
          </div>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</Layout>

<style>
  /* Hero Section */
  .hero-section {
    padding: 5rem 0 4rem;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: center;
  }

  .hero-issue-number {
    font-family: var(--font-serif);
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
    margin: 0.5rem 0 0;
  }

  .hero-issue-title {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0.5rem 0 0.5rem;
    color: var(--color-ink);
  }

  .hero-issue-season {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    color: var(--color-ink-muted);
    margin: 0 0 1.5rem;
    font-weight: 500;
  }

  .hero-editorial {
    font-family: var(--font-serif-body);
    font-size: 1rem;
    line-height: 1.75;
    color: var(--color-ink-secondary);
    margin-bottom: 2rem;
    display: -webkit-box;
    -webkit-line-clamp: 5;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .hero-cover {
    position: relative;
  }

  .hero-cover-img {
    width: 100%;
    height: auto;
    border-radius: 3px;
    box-shadow: 0 4px 20px rgba(26, 25, 22, 0.12);
    display: block;
  }

  .hero-cover-placeholder {
    aspect-ratio: 7/5;
    background: var(--color-paper-dark);
    border: 1px solid var(--color-border);
    border-radius: 3px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-cover-placeholder span {
    font-family: var(--font-serif);
    font-size: 6rem;
    font-weight: 700;
    color: var(--color-border);
  }

  /* Buttons */
  .btn-primary {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-paper);
    background: var(--color-ink);
    border: 1px solid var(--color-ink);
    padding: 0.75rem 1.5rem;
    text-decoration: none;
    border-radius: 3px;
    letter-spacing: 0.01em;
    transition: background 0.15s, border-color 0.15s;
  }

  .btn-primary:hover {
    background: var(--color-burgundy);
    border-color: var(--color-burgundy);
  }

  .btn-secondary {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-burgundy);
    border: 1px solid var(--color-burgundy);
    padding: 0.65rem 1.25rem;
    text-decoration: none;
    border-radius: 3px;
    transition: background 0.15s, color 0.15s;
  }

  .btn-secondary:hover {
    background: var(--color-burgundy);
    color: var(--color-paper);
  }

  /* Sections */
  .section {
    padding: 4rem 0;
  }

  .section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2rem;
    border-bottom: 2px solid var(--color-ink);
    padding-bottom: 0.75rem;
  }

  .section-title {
    font-family: var(--font-serif);
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--color-ink);
    margin: 0;
  }

  .section-link {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--color-burgundy);
    text-decoration: none;
    white-space: nowrap;
  }

  .section-link:hover {
    color: var(--color-burgundy-dark);
  }

  .section-intro {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    color: var(--color-ink-secondary);
    margin-bottom: 1.5rem;
    line-height: 1.65;
  }

  .articles-grid--3 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0 3rem;
  }

  .reading-room-list {
    max-width: 72ch;
  }

  /* Latest grid */
  .latest-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0 4rem;
  }

  .latest-col-header {
    border-bottom: 2px solid var(--color-ink);
    padding-bottom: 0.5rem;
    margin-bottom: 0;
  }

  .latest-col-title {
    font-family: var(--font-serif);
    font-size: 1rem;
    font-weight: 600;
    margin: 0;
  }

  .latest-col-title a {
    color: var(--color-ink);
    text-decoration: none;
  }

  .latest-col-title a:hover {
    color: var(--color-burgundy);
  }

  .col-more-link {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--color-burgundy);
    text-decoration: none;
    display: inline-block;
    padding: 1rem 0 0;
    border-top: 1px solid var(--color-border);
    width: 100%;
  }

  /* About */
  .about-inner {
    max-width: 64ch;
  }

  .about-content h2 {
    margin-bottom: 1.25rem;
  }

  .about-content p {
    font-family: var(--font-sans);
    font-size: 0.975rem;
    line-height: 1.7;
    color: var(--color-ink-secondary);
    margin-bottom: 1em;
  }

  .about-content em {
    font-style: italic;
    color: var(--color-ink);
  }

  .about-content .btn-secondary {
    margin-top: 0.5rem;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .articles-grid--3 {
      grid-template-columns: repeat(2, 1fr);
    }
    .latest-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .hero-section {
      padding: 3rem 0;
    }

    .hero-inner {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .hero-cover {
      order: -1;
    }

    .hero-cover-img {
      max-height: 260px;
      object-fit: cover;
    }

    .articles-grid--3 {
      grid-template-columns: 1fr;
    }

    .latest-grid {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .latest-col {
      border-top: 1px solid var(--color-border);
      padding-top: 1.5rem;
      margin-top: 1.5rem;
    }

    .latest-col:first-child {
      border-top: none;
      padding-top: 0;
      margin-top: 0;
    }
  }
</style>
