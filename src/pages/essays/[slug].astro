---
import { getCollection } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';

export async function getStaticPaths() {
  const essays = await getCollection('essays', e => !e.data.draft);
  return essays.map(essay => ({
    params: { slug: essay.slug },
    props: { essay },
  }));
}

const { essay } = Astro.props;
const { Content } = await essay.render();
---

<ArticleLayout
  title={essay.data.title}
  author={essay.data.author}
  authorSlug={essay.data.authorSlug}
  date={essay.data.date}
  excerpt={essay.data.excerpt}
  tags={essay.data.tags}
  category={essay.data.category || 'Essays and Philosophy'}
  issue={essay.data.issue}
>
  <Content />
</ArticleLayout>
