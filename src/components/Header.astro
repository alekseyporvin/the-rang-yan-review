---
const navLeft = [
  { href: '/essays/', label: 'Essays and Philosophy' },
  { href: '/poetry/', label: 'Poetry' },
  { href: '/prose/', label: 'Prose' },
  { href: '/interviews/', label: 'Interviews' },
  { href: '/conversation-with/', label: 'Conversation With' },
  { href: '/criticism/', label: 'Criticism' },
];

const navRight = [
  { href: '/archive/', label: 'Archive' },
  { href: '/authors/', label: 'Authors' },
  { href: '/editorial-board/', label: 'Editorial Board' },
  { href: '/about/', label: 'About' },
  { href: '/submit-to-the-inaugural-issue/', label: 'Submit to the Inaugural Issue' },
];

const navLinks = [...navLeft, ...navRight];
const pathname = Astro.url.pathname;
---

<header class="site-header" role="banner">
  <div class="container">
    <div class="header-inner">
      <div class="header-masthead">
        <a href="/" class="masthead" aria-label="The Rang Yan Review — home">
          <div class="masthead__rule" aria-hidden="true"></div>

          <div class="masthead__title" aria-hidden="true">
            <span class="masthead__the">The</span>
            <span class="masthead__name">
              <span class="masthead__rang">Rang</span>
              <span class="masthead__yan">Yan</span>
            </span>
            <span class="masthead__review">Review</span>
          </div>

          <div class="masthead__double-rule" aria-hidden="true">
            <span></span>
            <span></span>
          </div>

          <div class="masthead__bottom">
            <span class="masthead__tagline">
              A monthly journal of literature, critical theory, and international culture
            </span>
            <span class="masthead__established">Est. 2026</span>
          </div>
        </a>

        <nav class="header-nav" aria-label="Main navigation">
          <ul class="nav-group" role="list">
            {navLinks.map(link => (
              <li>
                <a
                  href={link.href}
                  class={`nav-link${pathname.startsWith(link.href) ? ' nav-link--active' : ''}`}
                  aria-current={pathname.startsWith(link.href) ? 'page' : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>

      <button
        class="mobile-menu-btn"
        id="mobile-menu-btn"
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
      </button>
    </div>
  </div>

  <div class="mobile-nav" id="mobile-nav" aria-hidden="true">
    <nav aria-label="Mobile navigation">
      <ul role="list">
        {navLinks.map(link => (
          <li>
            <a
              href={link.href}
              class={`mobile-nav-link${pathname.startsWith(link.href) ? ' mobile-nav-link--active' : ''}`}
              aria-current={pathname.startsWith(link.href) ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background: var(--color-paper);
    border-bottom: 1px solid var(--color-border);
    position: relative;
    z-index: 100;
  }

  .header-inner {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: 0.75rem;
    padding: 1.5rem 0 1.1rem;
  }

  .header-masthead {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 1.15rem;
    width: 100%;
    max-width: 100%;
  }

  .masthead {
    display: flex;
    flex-direction: column;
    gap: 0;
    text-decoration: none;
    color: inherit;
    width: 100%;
  }

  .masthead__bottom {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding-top: 0.75rem;
  }

  .masthead__established {
    font-family: var(--font-serif);
    font-size: 0.7rem;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
    white-space: nowrap;
  }

  .masthead__rule {
    display: block;
    width: 100%;
    height: 1px;
    margin: 0;
    background: var(--color-ink);
    border: none;
    opacity: 1;
  }

  .masthead__title {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-rows: auto auto auto;
    align-items: end;
    padding: 0.85rem 0 0.95rem;
    min-height: 5.5rem;
  }

  .masthead__the {
    grid-column: 2;
    grid-row: 1;
    justify-self: end;
    font-family: var(--font-serif);
    font-size: 0.78rem;
    font-weight: 400;
    letter-spacing: 0.55em;
    text-transform: uppercase;
    color: #b0aaa0;
    padding-right: 0.15em;
    margin-bottom: 0.15rem;
  }

  .masthead__name {
    grid-column: 1 / -1;
    grid-row: 2;
    display: flex;
    align-items: baseline;
    gap: 0.28em;
    font-family: var(--font-serif);
    font-size: clamp(3.4rem, 9vw, 5.6rem);
    font-weight: 700;
    line-height: 0.9;
    letter-spacing: -0.02em;
  }

  .masthead__rang {
    color: var(--color-ink);
  }

  .masthead__yan {
    color: var(--color-burgundy);
  }

  .masthead__review {
    grid-column: 2;
    grid-row: 3;
    justify-self: end;
    align-self: start;
    font-family: var(--font-serif);
    font-size: clamp(1rem, 2.4vw, 1.35rem);
    font-weight: 400;
    letter-spacing: 0.42em;
    text-transform: uppercase;
    color: var(--color-ink);
    padding-right: 0.12em;
    margin-top: 0.35rem;
  }

  .masthead__double-rule {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .masthead__double-rule span {
    display: block;
    width: 100%;
    height: 1px;
    background: var(--color-ink);
    opacity: 1;
  }

  .masthead__double-rule span:last-child {
    height: 2px;
  }

  .masthead__tagline {
    font-family: var(--font-serif-body);
    font-size: 0.82rem;
    font-style: italic;
    font-weight: 400;
    color: var(--color-ink-muted);
    line-height: 1.45;
    max-width: 34rem;
  }

  .masthead:hover .masthead__yan {
    color: var(--color-ink);
  }

  .masthead:hover .masthead__rang {
    color: var(--color-burgundy);
  }

  .header-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding-top: 0.15rem;
    overflow: visible;
  }

  .nav-group {
    display: flex;
    flex-wrap: nowrap;
    list-style: none;
    padding: 0;
    margin: 0;
    gap: 0;
    justify-content: space-between;
    width: 100%;
    white-space: nowrap;
  }

  .nav-link {
    font-family: var(--font-sans);
    font-size: 0.76rem;
    font-weight: 500;
    color: var(--color-ink-secondary);
    -webkit-text-fill-color: currentColor;
    text-decoration: none;
    padding: 0.3rem 0.22rem;
    border-radius: 3px;
    letter-spacing: 0;
    white-space: nowrap;
    display: inline-block;
    transform: scale(1);
    transform-origin: center;
    transition: color 0.25s ease, transform 0.28s ease, -webkit-text-fill-color 0.25s ease;
    text-underline-offset: 0.28em;
  }

  .header-nav a.nav-link:hover,
  .header-nav a.nav-link:focus-visible {
    color: #1f8a4c;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    background: transparent;
    transform: scale(1.18);
  }

  .nav-link--active {
    color: var(--color-burgundy);
    font-weight: 600;
  }

  .header-nav a.nav-link--active:hover,
  .header-nav a.nav-link--active:focus-visible {
    color: #1f8a4c;
  }

  .mobile-menu-btn {
    display: none;
    flex-direction: column;
    gap: 5px;
    padding: 0.5rem;
    background: none;
    border: none;
    cursor: pointer;
    border-radius: 4px;
  }

  .mobile-menu-btn:hover {
    background: var(--color-paper-dark);
  }

  .hamburger-line {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--color-ink);
    border-radius: 2px;
    transition: transform 0.2s, opacity 0.2s;
  }

  .mobile-menu-btn[aria-expanded="true"] .hamburger-line:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .mobile-menu-btn[aria-expanded="true"] .hamburger-line:nth-child(2) {
    opacity: 0;
  }
  .mobile-menu-btn[aria-expanded="true"] .hamburger-line:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .mobile-nav {
    display: none;
    background: var(--color-paper);
    border-top: 1px solid var(--color-border);
    padding: 1rem 0 1.5rem;
  }

  .mobile-nav ul {
    list-style: none;
    padding: 0 1.25rem;
    margin: 0;
  }

  .mobile-nav-link {
    display: block;
    font-family: var(--font-sans);
    font-size: 1.235rem;
    font-weight: 500;
    color: var(--color-ink-secondary);
    text-decoration: none;
    padding: 0.65rem 0;
    border-bottom: 1px solid var(--color-border-light);
    transition: color 0.15s;
  }

  .mobile-nav-link:hover,
  .mobile-nav-link:focus-visible {
    color: #1f8a4c;
  }

  .mobile-nav-link:last-child {
    border-bottom: none;
  }

  .mobile-nav-link--active {
    color: var(--color-burgundy);
  }

  .mobile-nav-link--active:hover,
  .mobile-nav-link--active:focus-visible {
    color: #1f8a4c;
  }

  .mobile-nav[aria-hidden="false"] {
    display: block;
  }

  @media (max-width: 1200px) {
    .header-inner {
      justify-content: space-between;
      align-items: flex-start;
    }

    .header-masthead {
      flex: 1 1 auto;
      min-width: 0;
      width: 100%;
    }

    .mobile-menu-btn {
      display: flex;
      flex-shrink: 0;
      margin-top: 0.35rem;
    }

    .header-nav {
      display: none;
    }

    .mobile-nav {
      display: none;
    }

    .mobile-nav[aria-hidden="false"] {
      display: block;
    }
  }

  @media (max-width: 720px) {
    .masthead__bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.35rem;
    }

    .masthead__established {
      text-align: left;
    }

    .masthead__name {
      font-size: clamp(2.6rem, 14vw, 3.6rem);
    }

    .masthead__tagline {
      font-size: 0.78rem;
    }
  }
</style>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const nav = document.getElementById('mobile-nav');

  if (btn && nav) {
    btn.addEventListener('click', () => {
      const isOpen = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!isOpen));
      nav.setAttribute('aria-hidden', String(isOpen));
    });

    document.addEventListener('click', (e) => {
      if (!btn.contains(e.target as Node) && !nav.contains(e.target as Node)) {
        btn.setAttribute('aria-expanded', 'false');
        nav.setAttribute('aria-hidden', 'true');
      }
    });
  }

  document
    .querySelectorAll('.site-header .nav-link, .site-header .mobile-nav-link')
    .forEach((link) => {
      const el = link as HTMLElement;
      link.addEventListener('mouseenter', () => {
        el.classList.add('is-hovered');
        el.style.setProperty('color', '#1f8a4c', 'important');
        el.style.setProperty('-webkit-text-fill-color', '#1f8a4c', 'important');
      });
      link.addEventListener('mouseleave', () => {
        el.classList.remove('is-hovered');
        el.style.removeProperty('color');
        el.style.removeProperty('-webkit-text-fill-color');
      });
    });
</script>
