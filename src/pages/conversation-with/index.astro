---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ArticleCard from '../../components/ArticleCard.astro';

const allConversations = (await getCollection('conversation-with', e => !e.data.draft))
  .sort((a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0));

const allTags = [...new Set(allConversations.flatMap(e => e.data.tags))].sort();
const selectedTag = Astro.url.searchParams.get('tag') || '';
const filtered = selectedTag
  ? allConversations.filter(e => e.data.tags.includes(selectedTag))
  : allConversations;
---

<Layout
  title="Conversation With | The Rang Yan Review"
  description="Thought staged as collective, unfinished labor: two people meeting as equals, with meaning accumulating in the exchange rather than handed down as a finished product."
>
  <Header />

  <main id="main-content">
    <div class="container section-page">
      <header class="section-page-header">
        <p class="category-label">Section</p>
        <h1 class="section-page-title">Conversation With</h1>
        <div class="section-page-desc">
          <p>
            Thought, here, refuses to arrive pre-packaged as product. Against the myth of the solitary genius dispensing finished insight from above, Conversation With stages knowledge as what it has always actually been: collective, unfinished, made in the friction between two minds rather than handed down by one.
          </p>
          <p>
            Each installment is a written trace of thinking as labor — two people meeting as equals, with no editorial hierarchy pre-deciding whose voice governs the exchange, letting meaning accumulate in real time rather than presenting it as a conclusion already reached elsewhere.
          </p>
          <p>
            This is not commentary about thought; it is thought’s own unrehearsed, horizontal record — a refusal of the extractive logic that turns dialogue into content, and an insistence that understanding is something built together, in the open, or not built honestly at all.
          </p>
        </div>
      </header>

      {allTags.length > 0 && (
        <nav class="tag-filter" aria-label="Filter by tag">
          <span class="tag-filter__label">Filter:</span>
          <div class="tag-filter__tags">
            <a href="/conversation-with/" class={`tag-btn${!selectedTag ? ' tag-btn--active' : ''}`}>All</a>
            {allTags.map(tag => (
              <a
                href={`/conversation-with/?tag=${encodeURIComponent(tag)}`}
                class={`tag-btn${selectedTag === tag ? ' tag-btn--active' : ''}`}
              >{tag}</a>
            ))}
          </div>
        </nav>
      )}

      {filtered.length === 0 ? (
        <p class="no-results">{selectedTag ? 'No conversations found for this tag.' : 'No conversations published yet.'}</p>
      ) : (
        <div class="articles-list">
          {filtered.map(conversation => (
            <ArticleCard
              title={conversation.data.title}
              author={conversation.data.author}
              authorSlug={conversation.data.authorSlug}
              date={conversation.data.date}
              excerpt={conversation.data.excerpt}
              href={`/conversation-with/${conversation.slug}/`}
              tags={conversation.data.tags}
              size="large"
            />
          ))}
        </div>
      )}
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .section-page { padding: 4rem 0 0; }
  .section-page-header {
    max-width: 64ch;
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 2px solid var(--color-ink);
  }
  .section-page-header .category-label { margin-bottom: 0.5rem; }
  .section-page-title {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 700;
    margin: 0 0 1rem;
    letter-spacing: -0.02em;
    color: var(--color-ink);
  }
  .section-page-desc {
    font-family: var(--font-serif-body);
    font-size: 1.05rem;
    color: var(--color-ink-secondary);
    line-height: 1.75;
  }
  .section-page-desc p {
    margin: 0 0 1.1em;
  }
  .section-page-desc p:last-child {
    margin-bottom: 0;
  }
  .tag-filter {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    margin-bottom: 2.5rem;
  }
  .tag-filter__label {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-ink-muted);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .tag-filter__tags { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .tag-btn {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--color-ink-secondary);
    background: transparent;
    border: 1px solid var(--color-border);
    padding: 0.3rem 0.7rem;
    border-radius: 2px;
    text-decoration: none;
    transition: all 0.15s;
  }
  .tag-btn:hover, .tag-btn--active {
    background: var(--color-ink);
    border-color: var(--color-ink);
    color: var(--color-paper);
  }
  .articles-list { max-width: 72ch; }
  .no-results {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    color: var(--color-ink-muted);
    padding: 2rem 0;
  }
</style>
