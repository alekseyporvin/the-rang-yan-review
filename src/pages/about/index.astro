    flex-direction: column;
    gap: 0;
  }

  .about-section {
    padding-bottom: 0;
    margin-bottom: 0;
  }

  .about-section p {
    font-family: var(--font-serif-body);
    font-size: 1rem;
    line-height: 1.85;
    color: var(--color-ink-secondary);
    margin-bottom: 1em;
  }

  .about-section p:last-child {
    margin-bottom: 0;
  }

  .about-section em {
    font-style: italic;
    color: var(--color-ink);
  }

  .about-heading {
