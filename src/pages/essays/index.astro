---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ArticleCard from '../../components/ArticleCard.astro';

const allEssays = (await getCollection('essays', e => !e.data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// Collect all unique tags
const allTags = [...new Set(allEssays.flatMap(e => e.data.tags))].sort();

const selectedTag = Astro.url.searchParams.get('tag') || '';
const filtered = selectedTag
  ? allEssays.filter(e => e.data.tags.includes(selectedTag))
  : allEssays;
---

<Layout
  title="Essays | The Rangzen Review"
  description="Long-form essays on philosophy, politics, culture, and critical theory. The Rangzen Review."
>
  <Header />

  <main id="main-content">
    <div class="container section-page">
      <header class="section-page-header">
        <p class="category-label">Section</p>
        <h1 class="section-page-title">Essays</h1>
        <p class="section-page-desc">
          Long-form essays on philosophy, politics, intellectual history, culture, and the conditions of critical thought.
        </p>
      </header>

      {allTags.length > 0 && (
        <nav class="tag-filter" aria-label="Filter by tag">
          <span class="tag-filter__label">Filter by topic:</span>
          <div class="tag-filter__tags">
            <a
              href="/essays/"
              class={`tag-btn${!selectedTag ? ' tag-btn--active' : ''}`}
              aria-current={!selectedTag ? 'page' : undefined}
            >All</a>
            {allTags.map(tag => (
              <a
                href={`/essays/?tag=${encodeURIComponent(tag)}`}
                class={`tag-btn${selectedTag === tag ? ' tag-btn--active' : ''}`}
                aria-current={selectedTag === tag ? 'page' : undefined}
              >{tag}</a>
            ))}
          </div>
        </nav>
      )}

      {filtered.length === 0 ? (
        <p class="no-results">No essays found for this tag.</p>
      ) : (
        <div class="articles-list">
          {filtered.map(essay => (
            <ArticleCard
              title={essay.data.title}
              author={essay.data.author}
              authorSlug={essay.data.authorSlug}
              date={essay.data.date}
              excerpt={essay.data.excerpt}
              href={`/essays/${essay.slug}/`}
              tags={essay.data.tags}
              size="large"
            />
          ))}
        </div>
      )}
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .section-page {
    padding: 4rem 0 0;
  }

  .section-page-header {
    max-width: 60ch;
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 2px solid var(--color-ink);
  }

  .section-page-header .category-label {
    margin-bottom: 0.5rem;
  }

  .section-page-title {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 700;
    margin: 0 0 1rem;
    letter-spacing: -0.02em;
    color: var(--color-ink);
  }

  .section-page-desc {
    font-family: var(--font-sans);
    font-size: 0.975rem;
    color: var(--color-ink-secondary);
    line-height: 1.65;
    margin: 0;
  }

  .tag-filter {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    margin-bottom: 2.5rem;
  }

  .tag-filter__label {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-ink-muted);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .tag-filter__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tag-btn {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--color-ink-secondary);
    background: transparent;
    border: 1px solid var(--color-border);
    padding: 0.3rem 0.7rem;
    border-radius: 2px;
    text-decoration: none;
    transition: all 0.15s;
  }

  .tag-btn:hover,
  .tag-btn--active {
    background: var(--color-ink);
    border-color: var(--color-ink);
    color: var(--color-paper);
  }

  .articles-list {
    max-width: 72ch;
  }

  .no-results {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    color: var(--color-ink-muted);
    padding: 2rem 0;
  }
</style>
