---
const currentYear = new Date().getFullYear();
---

<footer class="site-footer" role="contentinfo">
  <div class="container">
    <div class="footer-inner">
      <div class="footer-brand">
        <a href="/" class="footer-brand-link">The Rangzen Review</a>
        <p class="footer-desc">
          A journal of literature, philosophy, and critical thought.
          Published independently.
        </p>
        <p class="footer-email">
          <a href="mailto:editors@rangzenreview.org">editors@rangzenreview.org</a>
        </p>
      </div>

      <nav class="footer-nav" aria-label="Footer navigation">
        <div class="footer-nav-col">
          <span class="footer-nav-heading">Sections</span>
          <ul role="list">
            <li><a href="/essays/">Essays</a></li>
            <li><a href="/poetry/">Poetry</a></li>
            <li><a href="/prose/">Prose</a></li>
            <li><a href="/reading-room/">Reading Room</a></li>
          </ul>
        </div>
        <div class="footer-nav-col">
          <span class="footer-nav-heading">Journal</span>
          <ul role="list">
            <li><a href="/archive/">Archive</a></li>
            <li><a href="/authors/">Authors</a></li>
            <li><a href="/editorial-board/">Editorial Board</a></li>
            <li><a href="/about/">About</a></li>
          </ul>
        </div>
        <div class="footer-nav-col">
          <span class="footer-nav-heading">Subscribe</span>
          <ul role="list">
            <li><a href="/rss.xml">RSS Feed</a></li>
          </ul>
        </div>
      </nav>
    </div>

    <div class="footer-bottom">
      <p class="footer-copyright">
        &copy; {currentYear} The Rangzen Review. All rights reserved.
      </p>
      <p class="footer-note">
        Published under a commitment to independent, non-commercial literary culture.
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-paper-dark);
    border-top: 1px solid var(--color-border);
    margin-top: 6rem;
    padding: 4rem 0 2rem;
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1.5fr 2fr;
    gap: 4rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid var(--color-border);
  }

  .footer-brand-link {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-ink);
    text-decoration: none;
    display: block;
    margin-bottom: 0.75rem;
  }

  .footer-brand-link:hover {
    color: var(--color-burgundy);
  }

  .footer-desc {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    color: var(--color-ink-secondary);
    line-height: 1.6;
    margin-bottom: 0.75rem;
  }

  .footer-email a {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    color: var(--color-burgundy);
    text-decoration: none;
  }

  .footer-email a:hover {
    text-decoration: underline;
  }

  .footer-nav {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .footer-nav-heading {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
    display: block;
    margin-bottom: 0.75rem;
  }

  .footer-nav ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .footer-nav a {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--color-ink-secondary);
    text-decoration: none;
  }

  .footer-nav a:hover {
    color: var(--color-burgundy);
  }

  .footer-bottom {
    padding-top: 1.75rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .footer-copyright,
  .footer-note {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    color: var(--color-ink-muted);
  }

  @media (max-width: 768px) {
    .footer-inner {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .footer-nav {
      grid-template-columns: repeat(2, 1fr);
    }

    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  @media (max-width: 480px) {
    .footer-nav {
      grid-template-columns: 1fr;
    }
  }
</style>
