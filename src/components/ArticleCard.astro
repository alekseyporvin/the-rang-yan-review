---
import { articleDateTime, formatArticleDate, type DatePrecision } from '../lib/dates';
import { withJournalItalics, withTitleItalics, plainTitle } from '../lib/journal';
import { getEarlierVoiceSlugs, voiceLabelFor } from '../lib/voices';

interface Props {
  category?: string;
  title: string;
  author: string;
  authorSlug?: string;
  date?: Date;
  datePrecision?: DatePrecision;
  excerpt: string;
  href: string;
  tags?: string[];
  featured?: boolean;
  size?: 'normal' | 'large';
  coverImage?: string;
}

const {
  category,
  title,
  author,
  authorSlug,
  date,
  datePrecision = 'day',
  excerpt,
  href,
  tags = [],
  featured = false,
  size = 'normal',
  coverImage,
} = Astro.props;

const formattedDate = date ? formatArticleDate(date, datePrecision) : null;
const dateTime = date ? articleDateTime(date, datePrecision) : null;

const earlierVoiceSlugs = await getEarlierVoiceSlugs();
const voice = voiceLabelFor(authorSlug, earlierVoiceSlugs);
const voiceClass = voice === 'earlier voice' ? 'voice-mark--earlier' : 'voice-mark--contemporary';
---

<article class={`article-card${featured ? ' article-card--featured' : ''}${size === 'large' ? ' article-card--large' : ''}${coverImage ? ' article-card--with-cover' : ''}`}>
  {coverImage && (
    <a href={href} class="article-card__cover-link" tabindex="-1" aria-hidden="true">
      <img
        class="article-card__cover"
        src={coverImage}
        alt=""
        width="140"
        height="180"
        loading="lazy"
        decoding="async"
      />
    </a>
  )}

  <div class="article-card__body">
    {category && <span class="category-label">{category}</span>}

    <h3 class="article-card__title">
      <a href={href} set:html={withTitleItalics(title)} />
      <span class={`voice-mark ${voiceClass}`}>{voice}</span>
    </h3>

    <div class="article-card__meta">
      {authorSlug ? (
        <a href={`/authors/${authorSlug}/`} class="article-card__author">{author}</a>
      ) : (
        <span class="article-card__author">{author}</span>
      )}
      {formattedDate && date && (
        <>
          <span class="article-card__sep" aria-hidden="true">·</span>
          <time datetime={dateTime} class="article-card__date">{formattedDate}</time>
        </>
      )}
    </div>

    <p class="article-card__excerpt" set:html={withJournalItalics(excerpt)} />

    {tags.length > 0 && (
      <ul class="article-card__tags" role="list" aria-label="Tags">
        {tags.slice(0, 3).map(tag => (
          <li class="article-card__tag">{tag}</li>
        ))}
      </ul>
    )}

    <a href={href} class="article-card__link" aria-label={`Read: ${plainTitle(title)}`}>
      Read <span aria-hidden="true">→</span>
    </a>
  </div>
</article>

<style>
  .article-card {
    border-top: 1px solid var(--color-border);
    padding: 1.75rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .article-card--with-cover {
    flex-direction: row;
    align-items: flex-start;
    gap: 1.25rem;
  }

  .article-card__cover-link {
    flex: 0 0 auto;
    display: block;
    line-height: 0;
  }

  .article-card__cover {
    display: block;
    width: 10.5rem;
    height: auto;
    object-fit: contain;
    border: 1px solid var(--color-border);
    background: var(--color-paper);
  }

  .article-card__body {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .article-card--large .article-card__title {
    font-size: 1.5rem;
  }

  .article-card--featured {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    padding: 1.75rem;
    box-shadow: 0 1px 3px rgba(26, 25, 22, 0.04);
  }

  .article-card__title {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    font-weight: 600;
    line-height: 1.35;
    margin: 0.25rem 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.55rem 0.75rem;
  }

  .article-card__title a {
    color: var(--color-ink);
    text-decoration: none;
  }

  .article-card__title a:hover {
    color: var(--color-burgundy);
  }

  .voice-mark {
    display: inline-block;
    flex: 0 0 auto;
    font-family: var(--font-sans);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    line-height: 1;
    padding: 0.28rem 0;
    border-bottom: 1px solid currentColor;
    white-space: nowrap;
  }

  .voice-mark--contemporary {
    color: var(--color-green);
  }

  .voice-mark--earlier {
    color: var(--color-burgundy);
  }

  .article-card__meta {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    color: var(--color-ink-muted);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .article-card__author {
    color: var(--color-ink-secondary);
    font-weight: 500;
    text-decoration: none;
  }

  a.article-card__author:hover {
    color: var(--color-burgundy);
  }

  .article-card__sep {
    color: var(--color-border);
  }

  .article-card__excerpt {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    color: var(--color-ink-secondary);
    line-height: 1.6;
    margin: 0;
  }

  .article-card__tags {
    list-style: none;
    padding: 0;
    margin: 0.25rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .article-card__tag {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    color: var(--color-ink-muted);
    background: var(--color-paper-dark);
    border: 1px solid var(--color-border);
    padding: 0.2rem 0.55rem;
    border-radius: 2px;
  }

  .article-card__link {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--color-burgundy);
    text-decoration: none;
    margin-top: 0.25rem;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  .article-card__link:hover {
    color: var(--color-burgundy-dark);
  }

  @media (max-width: 560px) {
    .article-card--with-cover {
      flex-direction: column;
    }

    .article-card__cover {
      width: 10.5rem;
    }
  }
</style>
