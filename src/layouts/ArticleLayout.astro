---
import Layout from './Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  author: string;
  authorSlug?: string;
  date: Date;
  excerpt?: string;
  tags?: string[];
  category?: string;
  issue?: string;
  isPoetry?: boolean;
}

const {
  title,
  author,
  authorSlug,
  date,
  excerpt,
  tags = [],
  category,
  issue,
  isPoetry = false,
} = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const pageTitle = `${title} — ${author} | The Rangzen Review`;
---

<Layout
  title={pageTitle}
  description={excerpt}
  ogTitle={title}
  ogDescription={excerpt}
  articleDate={date.toISOString()}
>
  <Header />

  <main id="main-content">
    <article class="article-page">
      <header class="article-header container">
        {category && <p class="category-label">{category}</p>}
        <h1 class="article-title">{title}</h1>
        <div class="article-byline">
          {authorSlug ? (
            <a href={`/authors/${authorSlug}/`} class="article-byline__author">{author}</a>
          ) : (
            <span class="article-byline__author">{author}</span>
          )}
          <span aria-hidden="true">·</span>
          <time datetime={date.toISOString()}>{formattedDate}</time>
          {issue && (
            <>
              <span aria-hidden="true">·</span>
              <a href={`/archive/`} class="article-byline__issue">{issue}</a>
            </>
          )}
        </div>

        {excerpt && (
          <p class="article-standfirst">{excerpt}</p>
        )}

        {tags.length > 0 && (
          <ul class="article-tags" role="list" aria-label="Tags">
            {tags.map(tag => (
              <li class="article-tag">{tag}</li>
            ))}
          </ul>
        )}
      </header>

      <div class="article-body container">
        <div class={isPoetry ? 'prose-poetry' : 'prose-journal'}>
          <slot />
        </div>
      </div>

      <footer class="article-footer container">
        <div class="article-footer__inner">
          {authorSlug && (
            <a href={`/authors/${authorSlug}/`} class="article-footer__author-link">
              More by {author} →
            </a>
          )}
        </div>
      </footer>
    </article>
  </main>

  <Footer />
</Layout>

<style>
  .article-page {
    padding: 4rem 0 0;
  }

  .article-header {
    max-width: 72ch;
    margin-bottom: 3rem;
  }

  .article-header .category-label {
    margin-bottom: 1rem;
  }

  .article-title {
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 0 0 1.25rem;
    color: var(--color-ink);
  }

  .article-byline {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    color: var(--color-ink-muted);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .article-byline__author {
    color: var(--color-ink-secondary);
    font-weight: 600;
    text-decoration: none;
  }

  a.article-byline__author:hover,
  .article-byline__issue:hover {
    color: var(--color-burgundy);
  }

  .article-byline__issue {
    color: var(--color-ink-muted);
    text-decoration: none;
  }

  .article-standfirst {
    font-family: var(--font-serif-body);
    font-size: 1.2rem;
    line-height: 1.65;
    color: var(--color-ink-secondary);
    font-style: italic;
    border-top: 1px solid var(--color-border);
    padding-top: 1.25rem;
    margin-top: 0.5rem;
    margin-bottom: 0;
  }

  .article-tags {
    list-style: none;
    padding: 0;
    margin: 1.25rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .article-tag {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    color: var(--color-ink-muted);
    background: var(--color-paper-dark);
    border: 1px solid var(--color-border);
    padding: 0.25rem 0.6rem;
    border-radius: 2px;
    letter-spacing: 0.02em;
  }

  .article-body {
    max-width: 72ch;
  }

  .article-footer {
    max-width: 72ch;
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
    margin-bottom: 0;
  }

  .article-footer__inner {
    display: flex;
    justify-content: flex-end;
  }

  .article-footer__author-link {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--color-burgundy);
    text-decoration: none;
  }

  .article-footer__author-link:hover {
    color: var(--color-burgundy-dark);
  }

  @media (max-width: 768px) {
    .article-page {
      padding: 2.5rem 0 0;
    }
  }
</style>
