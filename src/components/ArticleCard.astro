---
interface Props {
  category?: string;
  title: string;
  author: string;
  authorSlug?: string;
  date: Date;
  excerpt: string;
  href: string;
  tags?: string[];
  featured?: boolean;
  size?: 'normal' | 'large';
}

const {
  category,
  title,
  author,
  authorSlug,
  date,
  excerpt,
  href,
  tags = [],
  featured = false,
  size = 'normal',
} = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class={`article-card${featured ? ' article-card--featured' : ''}${size === 'large' ? ' article-card--large' : ''}`}>
  {category && <span class="category-label">{category}</span>}

  <h3 class="article-card__title">
    <a href={href}>{title}</a>
  </h3>

  <div class="article-card__meta">
    {authorSlug ? (
      <a href={`/authors/${authorSlug}/`} class="article-card__author">{author}</a>
    ) : (
      <span class="article-card__author">{author}</span>
    )}
    <span class="article-card__sep" aria-hidden="true">·</span>
    <time datetime={date.toISOString()} class="article-card__date">{formattedDate}</time>
  </div>

  <p class="article-card__excerpt">{excerpt}</p>

  {tags.length > 0 && (
    <ul class="article-card__tags" role="list" aria-label="Tags">
      {tags.slice(0, 3).map(tag => (
        <li class="article-card__tag">{tag}</li>
      ))}
    </ul>
  )}

  <a href={href} class="article-card__link" aria-label={`Read: ${title}`}>
    Read <span aria-hidden="true">→</span>
  </a>
</article>

<style>
  .article-card {
    border-top: 1px solid var(--color-border);
    padding: 1.75rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .article-card--large .article-card__title {
    font-size: 1.5rem;
  }

  .article-card--featured {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    padding: 1.75rem;
    box-shadow: 0 1px 3px rgba(26, 25, 22, 0.04);
  }

  .article-card__title {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    font-weight: 600;
    line-height: 1.3;
    margin: 0.25rem 0;
  }

  .article-card__title a {
    color: var(--color-ink);
    text-decoration: none;
  }

  .article-card__title a:hover {
    color: var(--color-burgundy);
  }

  .article-card__meta {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    color: var(--color-ink-muted);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .article-card__author {
    color: var(--color-ink-secondary);
    font-weight: 500;
    text-decoration: none;
  }

  a.article-card__author:hover {
    color: var(--color-burgundy);
  }

  .article-card__sep {
    color: var(--color-border);
  }

  .article-card__excerpt {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    color: var(--color-ink-secondary);
    line-height: 1.6;
    margin: 0;
  }

  .article-card__tags {
    list-style: none;
    padding: 0;
    margin: 0.25rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .article-card__tag {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    color: var(--color-ink-muted);
    background: var(--color-paper-dark);
    border: 1px solid var(--color-border);
    padding: 0.2rem 0.55rem;
    border-radius: 2px;
  }

  .article-card__link {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--color-burgundy);
    text-decoration: none;
    margin-top: 0.25rem;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  .article-card__link:hover {
    color: var(--color-burgundy-dark);
  }
</style>
